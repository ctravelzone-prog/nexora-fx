# Nexora Fx — .gitignore

# Dependencies
node_modules/

# Environment secrets — NEVER commit these
.env

# SQLite database files
*.db
*.db-shm
*.db-wal

# Uploaded files
backend/uploads/*
!backend/uploads/.gitkeep

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/settings.json
*.swp
*.swo

# Logs
*.log
npm-debug.log*

# Build artifacts
dist/
build/

# Android app — build intermediates + signing secrets (never commit)
android-app/build-manual/
android-app/keystore.properties
