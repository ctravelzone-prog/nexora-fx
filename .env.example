# Nexora Fx — Environment Variables
# Copy this file to .env and fill in real values before running.
# NEVER commit .env with real values to version control.

# Server
PORT=3000
NODE_ENV=development
SITE_URL=http://localhost:3000

# JWT
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d

# Admin seed (used ONLY on first setup when no admin row exists)
# After first setup, change password via admin panel or npm run change-admin-password
# ADMIN_PASSWORD_HASH must be a bcrypt hash — never a plain-text password
ADMIN_EMAIL=admin@nexorafxuk
ADMIN_PASSWORD_HASH=REPLACE_WITH_BCRYPT_HASH_OF_YOUR_CHOSEN_PASSWORD

# SMTP (required for email verification and password reset)
# If absent, emails are logged to console in development only
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@nexorafxuk

# Database (SQLite file path, relative to backend/)
DB_PATH=./nexora-fx.db

# Uploads (profile pictures, trader avatars, KYC + forget documents)
# Default is backend/uploads. On the VPS set UPLOADS_DIR=/root/nexora-data/uploads
# so uploaded files live next to the database, outside the code repo.
UPLOADS_DIR=
FINNHUB_KEY=

# Auto payments (Binance) — secrets, NEVER commit real values.
# Read-only key: "Enable Reading" ONLY (no trading, no withdrawals).
# Used to verify Binance Pay deposits (GET /sapi/v1/pay/transactions).
BINANCE_READ_API_KEY=
BINANCE_READ_API_SECRET=
# Withdrawal key: "Enable Withdrawals" + "Enable Reading", Trading OFF.
# Used ONLY to send auto withdrawals (POST /sapi/v1/capital/withdraw/apply).
BINANCE_WITHDRAW_API_KEY=
BINANCE_WITHDRAW_API_SECRET=
# BscScan API key (optional). Without it, BEP20 verify uses the public
# BSC RPC. Can also be set in Admin > Money Settings > Auto Payments.
BSCSCAN_API_KEY=
